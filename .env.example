# Investor Negotiation Game: local settings.
#
#   cp .env.example .env     then uncomment and fill in what you need.
#
# .env is read from the folder you run `investor-game` in, and it is git-ignored.
# Precedence: command-line flags > variables exported in your shell > this file.
# Values may be quoted. ${OTHER_VAR} is expanded inside double quotes or unquoted values;
# use single quotes for a literal "$".
# Every line below is commented out, so copying this file changes nothing until you edit it.

# --- Which AI runs the investor -------------------------------------------------
# Decision AI ("brain"): jev | laya | stub. Default: jev if TYPESAFE_API_KEY is set, else stub.
# INVESTOR_GAME_BRAIN=jev
# Text AI ("voice"): claude | ollama | stub. Default: claude if ANTHROPIC_API_KEY is set, else stub.
# INVESTOR_GAME_VOICE=ollama
# Use the built-in stub brain and voice (no network): true | false
# INVESTOR_GAME_OFFLINE=false

# --- TypeSafe Jev (hosted decision AI) ------------------------------------------
# API key from https://console.typesafe.ai/
# TYPESAFE_API_KEY=your-typesafe-key
# Override the API base URL (default https://api.typesafe.ai)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Model name (default jev-latest)
# TYPESAFE_MODEL=jev-latest

# --- Laya (local decision AI) ---------------------------------------------------
# Base URL of your local Jev-compatible Laya server (default http://localhost:8000)
# LAYA_BASE_URL=http://localhost:8000
# Model name sent to the Laya server (default laya)
# LAYA_MODEL=laya

# --- Anthropic Claude (hosted text AI) ------------------------------------------
# API key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-key
# Model (default claude-opus-5-5)
# INVESTOR_GAME_CLAUDE_MODEL=claude-opus-5-5

# --- Ollama (local text AI) -----------------------------------------------------
# Ollama server (default http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
# Model tag (default llama3.1), e.g. qwen2.5:3b
# INVESTOR_GAME_OLLAMA_MODEL=llama3.1

# --- Time limits (seconds) ------------------------------------------------------
# INVESTOR_GAME_BRAIN_TIMEOUT=10
# INVESTOR_GAME_VOICE_TIMEOUT=60

# --- Logging and debugging ------------------------------------------------------
# Write every LLM request/response as JSON files here (one folder per game)
# INVESTOR_GAME_LOG_DIR=logs
# Print detailed errors to stderr: true | false
# INVESTOR_GAME_DEBUG=false
